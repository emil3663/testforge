# TestForge environment configuration
# Copy this file to .env and fill in your values.

# ── AI test generation ──────────────────────────────────────────────────────
# Your OpenAI API key — required for AI-powered test generation.
# Without this, TestForge falls back to a sample test template.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: during consolidation, Next.js route handlers can proxy to an
# external backend service (for example FastAPI on port 8000).
# Leave blank to keep current in-process Next.js API behavior.
TESTFORGE_BACKEND_BASE_URL=

# Optional: legacy FastAPI UI transition controls.
# When true, GET / on FastAPI (port 8000) redirects to the Next.js UI URL.
TESTFORGE_DISABLE_LEGACY_UI=false
TESTFORGE_NEXT_UI_URL=http://localhost:3000

# ── Plane (test target via Docker) ─────────────────────────────────────────
# Change the secret key before running Plane in any non-local environment.
PLANE_SECRET_KEY=change-me-before-production

# MinIO credentials (used by Plane for file uploads)
MINIO_ROOT_USER=plane-access-key
MINIO_ROOT_PASSWORD=plane-secret-key
