# TestForge environment configuration
# Copy this file to .env and fill in your values.
#
# Security: TestForge is a local-only tool. /api/run executes caller-supplied
# code with the privileges of the user running the dev server. Do not bind
# this server to a non-loopback interface and do not expose it through a
# tunnel (ngrok, Cloudflare Tunnel, port forwarding, etc.).

# Optional: select an environment-specific overlay file for FastAPI.
# Supported examples in this repo: development, staging, production.
TESTFORGE_ENV=development

# ── AI test generation ──────────────────────────────────────────────────────
# Your OpenAI API key — required for AI-powered test generation.
# Without this, TestForge falls back to a sample test template.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Plane (test target via Docker) ─────────────────────────────────────────
# Change the secret key before running Plane in any non-local environment.
PLANE_SECRET_KEY=change-me-before-production

# MinIO credentials (used by Plane for file uploads)
MINIO_ROOT_USER=plane-access-key
MINIO_ROOT_PASSWORD=plane-secret-key

# Public site URL used by Next.js metadata helpers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
