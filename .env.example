# TestForge environment configuration
# Copy this file to .env and fill in your values.
#
# Security: TestForge is a local-only tool. /api/run executes caller-supplied
# code with the privileges of the user running the dev server. Do not bind
# this server to a non-loopback interface and do not expose it through a
# tunnel (ngrok, Cloudflare Tunnel, port forwarding, etc.).

# Optional: select an environment-specific overlay file for FastAPI.
# Supported examples in this repo: development, staging, production.
TESTFORGE_ENV=development

# ── AI test generation ──────────────────────────────────────────────────────
# Your OpenAI API key — required for AI-powered test generation.
# Without this, TestForge falls back to a sample test template.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: OpenAI call budget in ms (catalog lookup + completion). Default 30000.
# On failure or timeout TestForge falls back to the template generator.
# TESTFORGE_OPENAI_TIMEOUT_MS=30000

# ── Plane (test target via Docker) ─────────────────────────────────────────
# Change the secret key before running Plane in any non-local environment.
PLANE_SECRET_KEY=change-me-before-production

# MinIO credentials (used by Plane for file uploads)
MINIO_ROOT_USER=plane-access-key
MINIO_ROOT_PASSWORD=plane-secret-key

# Public site URL used by Next.js metadata helpers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Authenticated runs (Phase 20) ───────────────────────────────────────────
# A run can log in once and start every test signed in. The run request's
# "login" block names the environment variables holding the automation
# account's credentials - a credential value is NEVER put in the request, in
# generated code, or in a committed file. Set them here (in your local .env,
# not this example) under any names you like, then reference the names, e.g.
#   "usernameEnv": "MYAPP_TEST_USER", "passwordEnv": "MYAPP_TEST_PASS"
# MYAPP_TEST_USER=
# MYAPP_TEST_PASS=
#
# Read docs/AUTOMATED_ACCOUNT_SETUP.md first: what the automation account must be
# exempted from (lockout, rate limiting, MFA, new-sign-in alerts), and the exact
# fields of the login block.
