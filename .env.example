# Mr Onion environment configuration
# Copy this file to .env and fill in your values.
#
# Security: Mr Onion is a local-only tool. /api/run executes caller-supplied
# code with the privileges of the user running the dev server. Do not bind
# this server to a non-loopback interface and do not expose it through a
# tunnel (ngrok, Cloudflare Tunnel, port forwarding, etc.).

# Settings are named MRONION_*. The old TESTFORGE_* names still work until 1.0,
# with a notice in the server log.

# Optional: the environment's label in /api/health's output.
MRONION_ENV=development

# ── AI test generation ──────────────────────────────────────────────────────
# Optional, and parked: no live OpenAI completion has succeeded (TEST_PLAN.md,
# known limitation 5). The template generator is the default and needs no key.
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: OpenAI call budget in ms (catalog lookup + completion). Default 30000.
# On failure or timeout Mr Onion falls back to the template generator.
# MRONION_OPENAI_TIMEOUT_MS=30000

# Optional: generate with a local Ollama model instead (free, runs on your machine).
# When set, this wins over OPENAI_API_KEY. Setup: docs/LOCAL_MODEL_SETUP.md
# MRONION_OLLAMA_MODEL=mr-onion-qwen7b
# MRONION_OLLAMA_BASE_URL=http://localhost:11434/v1
# MRONION_OLLAMA_TIMEOUT_MS=180000

# ── Plane (test target via Docker) ─────────────────────────────────────────
# These are development placeholders from a public repo, safe only because
# docker-compose.yml publishes Plane and MinIO on 127.0.0.1. Set your own, all
# three, in .env (the file docker compose reads) before running Plane on any
# other machine or network.
PLANE_SECRET_KEY=change-me-before-production

# MinIO credentials (used by Plane for file uploads)
MINIO_ROOT_USER=plane-access-key
MINIO_ROOT_PASSWORD=plane-secret-key

# Public site URL used by Next.js metadata helpers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Authenticated runs (Phase 20) ───────────────────────────────────────────
# A run can log in once and start every test signed in. The run request's
# "login" block names the environment variables holding the automation
# account's credentials - a credential value is NEVER put in the request, in
# generated code, or in a committed file. Set them here (in your local .env,
# not this example) under any names you like, then reference the names, e.g.
#   "usernameEnv": "MYAPP_TEST_USER", "passwordEnv": "MYAPP_TEST_PASS"
# MYAPP_TEST_USER=
# MYAPP_TEST_PASS=
#
# Read docs/AUTOMATED_ACCOUNT_SETUP.md first: what the automation account must be
# exempted from (lockout, rate limiting, MFA, new-sign-in alerts), and the exact
# fields of the login block.
