{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: dev server",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}",
            "serverReadyAction": {
                "pattern": "(?:Local|Ready in).*?(https?://localhost:(\\d+))",
                "uriFormat": "%s",
                "action": "debugWithChrome"
            }
        },
        {
            "name": "Next.js: self-test server",
            "type": "node-terminal",
            "request": "launch",
            "preLaunchTask": "npm: build",
            "command": "npm run start:self-test",
            "cwd": "${workspaceFolder}",
            "serverReadyAction": {
                "pattern": "- Local:\\s+(https?://127\\.0\\.0\\.1:3001)",
                "uriFormat": "%s",
                "action": "debugWithChrome"
            }
        }
    ]
}