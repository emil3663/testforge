for (const artifact of matchingArtifacts.slice(5)) {
  core.info(`Deleting ${artifact.name} (${artifact.id}).`);
  await github.rest.actions.deleteArtifact({
    owner,
    repo,
    artifact_id: artifact.id,
  });
}
