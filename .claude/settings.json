{
  "extraKnownMarketplaces": {
    "testforge-skills-marketplace": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  },
  "enabledPlugins": {
    "testforge-skills@testforge-skills-marketplace": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if ! tasklist //FI \"IMAGENAME eq git.exe\" 2>/dev/null | grep -qi git.exe; then for f in .git/index.lock .git/HEAD.lock; do if [ -f \"$f\" ]; then rm -f \"$f\" && echo \"[hook] cleared stale $f (no git.exe running)\"; fi; done; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/stop-check.sh\"",
            "timeout": 120,
            "statusMessage": "TFP-251 stop check: eslint and tsc"
          }
        ]
      }
    ]
  }
}
