{
  "name": "testforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:development": "dotenv -e .env.development -- next dev",
    "dev:staging": "dotenv -e .env.staging -- next dev",
    "build": "next build",
    "build:self-test": "dotenv -e .env.development -- next build",
    "build:staging": "dotenv -e .env.staging -- next build",
    "build:production": "dotenv -e .env.production -- next build",
    "start": "next start",
    "start:staging": "dotenv -e .env.staging -- next start",
    "start:production": "dotenv -e .env.production -- next start",
    "start:self-test": "dotenv -e .env.development -- next start --hostname 127.0.0.1 --port 3001",
    "serve:self-test": "npm run build:self-test && npm run start:self-test",
    "lint": "eslint",
    "test:self": "playwright test -c playwright.self-test.config.ts",
    "test:self:allure": "node scripts/run-allure-suite.mjs smoke playwright.self-test.config.ts",
    "test:regression": "playwright test -c playwright.regression.config.ts",
    "test:regression:allure": "node scripts/run-allure-suite.mjs regression playwright.regression.config.ts",
    "report:open:smoke": "npx allure open artifacts/allure-report/smoke",
    "report:open:regression": "npx allure open artifacts/allure-report/regression"
  },
  "dependencies": {
    "@playwright/test": "^1.59.1",
    "next": "16.2.3",
    "openai": "^6.34.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "allure": "^3.5.0",
    "allure-playwright": "^3.7.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}