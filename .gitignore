# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# TestForge — temp test run files (created by /api/run)
/runs/

# ── Node / Next.js ───────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.playwright-runs/
/test-results/
/playwright-report/
/artifacts/

# next.js
/.next/
/out/

# production
/build

# ── Misc ─────────────────────────────────────────────────────────────────────
.DS_Store
*.pem

# local, machine-specific AI-agent tooling config - not project source
.clinerules

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/comparisons/
